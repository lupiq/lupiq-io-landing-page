---
import {getCollection, render} from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const byOrder = <T extends {data: {order: number}}>(a: T, b: T) =>
  a.data.order - b.data.order;
const pillars = (await getCollection('pillars')).sort(byOrder);
const services = (await getCollection('services')).sort(byOrder);
const work = (await getCollection('work')).sort(byOrder);

const pillarItems = await Promise.all(
  pillars.map(async entry => ({entry, Content: (await render(entry)).Content})),
);
const serviceItems = await Promise.all(
  services.map(async entry => ({
    entry,
    Content: (await render(entry)).Content,
  })),
);
const workItems = await Promise.all(
  work.map(async entry => ({entry, Content: (await render(entry)).Content})),
);
---

<Base
  title="lupiq – Software manufacture for full-stack web development & agile coaching"
  description="lupiq is a small software manufacture from Switzerland. We build great software and help teams become better – full-stack web development and agile coaching."
>
  <Header />

  <main>
    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">Software manufacture · Münsingen, Switzerland</p>
        <h1>
          Build great software.
          <br />
          Become a better team.
        </h1>
        <p class="lead">
          Projects rarely stall for lack of ideas. They stall on complexity and
          missing clarity. We're not a classic consultancy — we dive into the
          code, work in your team and make decisions with consequence.
        </p>
        <p>
          <a class="btn" href="#contact">
            Let's talk
          </a>
        </p>
      </div>
    </section>

    <section id="what-we-do" class="alt">
      <div class="wrap">
        <p class="eyebrow">What we do</p>
        <h2>We don't manage problems. We build solutions.</h2>
        <p class="lead">
          Full-stack web development and agile coaching, from a small crew that
          stays on board until the solution stands — and runs stable.
        </p>
        <div class="grid">
          {pillarItems.map(({entry, Content}) => (
            <article class="card">
              <h3>{entry.data.title}</h3>
              <Content />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="services">
      <div class="wrap">
        <p class="eyebrow">Craft, not buzzwords</p>
        <h2>Our services</h2>
        <div class="grid">
          {serviceItems.map(({entry, Content}) => (
            <article class="card">
              <h3>{entry.data.title}</h3>
              <Content />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="our-work" class="alt">
      <div class="wrap">
        <p class="eyebrow">Our Work</p>
        <h2>Things we've built (and open-sourced)</h2>
        <div class="grid">
          {workItems.map(({entry, Content}) => (
            <article class="card">
              <h3>{entry.data.title}</h3>
              <p class="accent">{entry.data.tagline}</p>
              <Content />
              <p class="card-cta">
                <a
                  class="btn"
                  href={entry.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {entry.data.cta} →
                </a>
                {entry.data.secondary && (
                  <a
                    class="link"
                    href={entry.data.secondary.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.data.secondary.label} →
                  </a>
                )}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="contact">
      <div class="wrap">
        <p class="eyebrow">Contact</p>
        <h2>Let's talk code, processes or your strategy.</h2>
        <p class="lead">
          We know the speed of startups and the structures of large
          organisations. Bring us your hairiest problem.
        </p>
        <p>
          <a class="btn" href="mailto:hello@lupiq.com">
            hello@lupiq.com
          </a>
          &nbsp;{' '}
          <a href="https://lupiq.com" target="_blank" rel="noopener noreferrer">
            Visit lupiq.com
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  .hero {
    padding: 6rem 0 5rem;
  }
  @media (max-width: 40rem) {
    .hero {
      padding: 3rem 0 3rem;
    }
  }
</style>
