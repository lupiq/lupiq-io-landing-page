{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["at any time"],
  "prHourlyLimit": 0,
  "rangeStrategy": "pin",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "commitMessageLowerCase": "never",
  "commitMessageAction": "Update",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "One grouped pull request for all minor and patch updates, merged automatically once the checks are green",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "non-major dependencies",
      "automerge": true
    },
    {
      "description": "Major updates are grouped as well, but reviewed manually",
      "matchUpdateTypes": ["major"],
      "groupName": "major dependencies",
      "automerge": false
    },
    {
      "description": "astro check does not support TypeScript 7 yet, so stay on TypeScript 6",
      "matchPackageNames": ["typescript"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
